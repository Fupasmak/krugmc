# ============================================================================
#  KRUG: переменные окружения (krugmc.ru)
#  Скопируй в .env и заполни. .env в git не коммитится.
#  Генерация секрета:  openssl rand -hex 32
# ============================================================================

# Режим production для Docker Compose на VPS.
NODE_ENV=production
# Основной публичный URL. SITE_URL оставлен для совместимости с кодом сайта.
APP_URL=https://krugmc.ru

# ----------------------------------------------------------------------------
#  1. База данных (общая для сайта и бота)
# ----------------------------------------------------------------------------
# Логин, пароль и имя БД использует контейнер postgres в docker-compose.yml
POSTGRES_USER=krug
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=krug

# Строка подключения для Prisma.
# Локально (БД на хосте):      postgresql://krug:пароль@localhost:5432/krug?schema=public
# В docker-compose (БД в сети): postgresql://krug:пароль@db:5432/krug?schema=public
DATABASE_URL=postgresql://krug:change_me_strong_password@localhost:5432/krug?schema=public

# ----------------------------------------------------------------------------
#  2. Сайт (web/)
# ----------------------------------------------------------------------------
# Публичный адрес сайта без слэша на конце. Локально: http://localhost:3000
SITE_URL=https://krugmc.ru
NEXT_PUBLIC_SITE_URL=https://krugmc.ru

# Ключ подписи сессионных cookie. 64 hex-символа. При замене все выйдут из аккаунтов.
SESSION_SECRET=change_me_64_hex_chars

# Главный админ: ник в Minecraft. Роль SUPERADMIN выдаётся ему автоматически
# при первом входе через Minecraft. Он раздаёт роль ADMIN остальным.
SUPERADMIN_NICKNAME=Fupasmak

# Куда складывать вложения завозов и архива. Внутри контейнера: /app/uploads.
UPLOAD_DIR=./uploads

# Лимиты загрузок (мегабайты)
MAX_IMAGE_MB=5
MAX_VIDEO_MB=200

# Фича-флаги: страницы, которые пока не показываем
FEATURE_CORNER=false
FEATURE_TEAM=false

# ----------------------------------------------------------------------------
#  3. Общие секреты между частями (НЕ показывать никому)
# ----------------------------------------------------------------------------
# HMAC-секрет «сайт <-> Minecraft-плагин».
# Тот же самый строкой прописывается в minecraft/.../config.yml -> api.secret
MC_HMAC_SECRET=change_me_64_hex_chars

# HMAC-секрет «сайт <-> Telegram-бот» (в обе стороны)
INTERNAL_API_SECRET=change_me_64_hex_chars

# ----------------------------------------------------------------------------
#  4. Telegram-бот (TGBOT/)
# ----------------------------------------------------------------------------
# Токен от @BotFather. Если токен где-то засветился, используй /revoke и сюда новый.
TG_BOT_TOKEN=000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Username бота без @. Используется сайтом для deep-link ссылок.
TG_BOT_USERNAME=KRUGSERVER_BOT

# Канал, подписка на который нужна для голосования.
# Бот обязан быть администратором этого канала, иначе getChatMember вернёт ошибку.
TG_CHANNEL=@serverKRUG

# Сколько секунд кэшировать результат проверки подписки
SUBSCRIPTION_CACHE_TTL=600

# Внутренний HTTP-сервер бота: через него сайт спрашивает «подписан ли юзер».
BOT_INTERNAL_PORT=8081
# Адрес этого сервера со стороны сайта.
# docker-compose: http://bot:8081   локально: http://127.0.0.1:8081
BOT_INTERNAL_URL=http://127.0.0.1:8081

# Режим получения апдейтов: polling (по умолчанию) или webhook
BOT_MODE=polling
# Только для BOT_MODE=webhook: публичный HTTPS-адрес вебхука и порт внутри контейнера
BOT_WEBHOOK_URL=https://krugmc.ru/tg/webhook
BOT_WEBHOOK_PORT=8443
# Секрет заголовка X-Telegram-Bot-Api-Secret-Token
BOT_WEBHOOK_SECRET=change_me_32_hex_chars

# ----------------------------------------------------------------------------
#  5. Внешние ссылки (показываются на сайте)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/serverKRUG
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/3NDaxr6aQz

# Внутренний адрес BlueMap (http://айпи:порт). Наружу не уходит, карта открывается через /mapview
MAP_UPSTREAM_URL=
